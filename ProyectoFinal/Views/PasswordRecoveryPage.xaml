<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinal.Views.PasswordRecoveryPage"
             Title="Recuperar contraseña"
             BackgroundColor="#F4FBF6">
    <ScrollView>
        <VerticalStackLayout Padding="28,45,28,28" Spacing="16">
            <Border BackgroundColor="#DDF2E4" StrokeThickness="0" StrokeShape="RoundRectangle 26" Padding="20">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Recuperar contraseña" FontSize="26" FontAttributes="Bold" TextColor="#145C43"/>
                    <Label Text="Te enviaremos un código de seis dígitos a tu correo." TextColor="#4A6A58"/>
                </VerticalStackLayout>
            </Border>
            <Entry x:Name="EmailEntry" Placeholder="Correo electrónico" Keyboard="Email"/>
            <Button Text="Enviar código" Clicked="SendCodeClicked" BackgroundColor="#19704F" TextColor="White" CornerRadius="12" HeightRequest="52"/>
            <BoxView HeightRequest="1" BackgroundColor="#CAE4D3" Margin="0,8"/>
            <Label Text="Ingresa el código recibido y tu nueva contraseña" TextColor="#355C4A" FontAttributes="Bold"/>
            <Entry x:Name="CodeEntry" Placeholder="Código de 6 dígitos" Keyboard="Numeric" MaxLength="6"/>
            <Entry x:Name="NewPasswordEntry" Placeholder="Nueva contraseña (mínimo 4 caracteres)" IsPassword="True"/>
            <Label x:Name="MessageLabel" TextColor="#A63D40"/>
            <Button Text="Cambiar contraseña" Clicked="ResetPasswordClicked" BackgroundColor="#5A2DDF" TextColor="White" CornerRadius="12" HeightRequest="52"/>
            <Button Text="Volver a iniciar sesión" Clicked="BackClicked" BackgroundColor="White" TextColor="#19704F" BorderColor="#B8DCC7" BorderWidth="1" CornerRadius="12" HeightRequest="50"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
