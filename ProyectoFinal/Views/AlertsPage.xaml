<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinal.Views.AlertsPage"
             Title="Alertas"
             BackgroundColor="#FCFFFC">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,30" Spacing="12">
            <Label Text="Próximos vencimientos" FontSize="26" FontAttributes="Bold" TextColor="#174F3B"/>
            <Label x:Name="Summary" TextColor="#587168"/>

            <CollectionView x:Name="AlertList" HeightRequest="190" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No hay alimentos que requieran atención." TextColor="#587168" Margin="0,12"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#FFF1D6" Stroke="#F1DBB3" StrokeShape="RoundRectangle 14" Padding="14" Margin="0,4">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" TextColor="#644C22"/>
                                <Label Text="{Binding ExpirationDate, StringFormat='Vence el {0:dd/MM/yyyy}'}" TextColor="#806631"/>
                                <Label Text="{Binding Status}" TextColor="#806631" FontSize="12"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Recetas para aprovechar" FontSize="22" FontAttributes="Bold" TextColor="#174F3B" Margin="0,10,0,0"/>
            <Label Text="Ideas basadas en alimentos próximos a vencer." TextColor="#587168" FontSize="13"/>

            <CollectionView x:Name="RecipeList" HeightRequest="310" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Border BackgroundColor="#EAF6ED" Stroke="#C9E6D1" StrokeShape="RoundRectangle 14" Padding="16" Margin="0,6">
                        <Label Text="Cuando agregues alimentos que vencen pronto, aquí recibirás una idea para usarlos." TextColor="#356552"/>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{Binding AccentColor}" Stroke="#D5E8D9" StrokeShape="RoundRectangle 16" Padding="16" Margin="0,5">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="#174F3B"/>
                                <Label Text="{Binding Description}" TextColor="#45695B"/>
                                <Label Text="{Binding Ingredients}" FontSize="13" TextColor="#174F3B" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
