<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ProyectoFinal.Views.AlertsPage" Title="Alertas"><VerticalStackLayout Padding="20" Spacing="12"><Label Text="Próximos vencimientos" FontSize="26" FontAttributes="Bold"/><Label x:Name="Summary"/><CollectionView x:Name="AlertList"><CollectionView.ItemTemplate><DataTemplate><Frame BackgroundColor="#FFF1D6" CornerRadius="8" Margin="0,4"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold"/><Label Text="{Binding ExpirationDate, StringFormat='Vence el {0:dd/MM/yyyy}'}"/><Label Text="{Binding Status}"/></VerticalStackLayout></Frame></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></ContentPage>
