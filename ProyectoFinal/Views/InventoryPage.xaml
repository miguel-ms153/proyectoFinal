<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ProyectoFinal.Views.InventoryPage" Title="Inventario"><VerticalStackLayout Padding="20" Spacing="12"><Label Text="Productos disponibles" FontSize="26" FontAttributes="Bold"/><CollectionView x:Name="ProductList"><CollectionView.ItemTemplate><DataTemplate><Frame CornerRadius="8" Margin="0,4"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold"/><Label Text="{Binding Category}"/><Label Text="{Binding Status}" TextColor="#1C6B4C"/></VerticalStackLayout><Button Grid.Column="1" Text="Consumir" CommandParameter="{Binding Id}" Clicked="ConsumeClicked"/></Grid></Frame></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></ContentPage>
