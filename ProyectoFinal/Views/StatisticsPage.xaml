<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ProyectoFinal.Views.StatisticsPage" Title="Estadísticas">
  <ScrollView><VerticalStackLayout Padding="24" Spacing="14">
    <Label Text="Tu impacto" FontSize="28" FontAttributes="Bold"/>
    <Frame BackgroundColor="#E1F1E8"><VerticalStackLayout><Label Text="Unidades consumidas a tiempo"/><Label x:Name="Consumed" FontSize="30" FontAttributes="Bold"/></VerticalStackLayout></Frame>
    <Frame BackgroundColor="#F2E7F8"><VerticalStackLayout><Label Text="Inventario activo"/><Label x:Name="Active" FontSize="30" FontAttributes="Bold"/></VerticalStackLayout></Frame>
    <Frame BackgroundColor="#FCE1E1"><VerticalStackLayout><Label Text="Unidades desperdiciadas"/><Label x:Name="Wasted" FontSize="30" FontAttributes="Bold"/></VerticalStackLayout></Frame>
    <Button Text="Registrar ubicación actual" Clicked="LocationClicked"/><Label x:Name="LocationStatus"/>
  </VerticalStackLayout></ScrollView>
</ContentPage>
