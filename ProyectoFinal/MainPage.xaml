<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ProyectoFinal.MainPage" Title="Inicio">
 <ScrollView><VerticalStackLayout Padding="24" Spacing="16">
  <Label Text="EcoScan Hogar" FontSize="30" FontAttributes="Bold" TextColor="#1C6B4C" />
  <Label Text="Tus alimentos, a tiempo." FontSize="17" />
  <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><Frame BackgroundColor="#E1F1E8" CornerRadius="8"><VerticalStackLayout><Label Text="Productos"/><Label x:Name="Products" FontSize="30" FontAttributes="Bold"/></VerticalStackLayout></Frame><Frame Grid.Column="1" BackgroundColor="#FFF1D6" CornerRadius="8"><VerticalStackLayout><Label Text="Por vencer"/><Label x:Name="Expiring" FontSize="30" FontAttributes="Bold"/></VerticalStackLayout></Frame></Grid>
  <Button Text="Agregar producto" Clicked="AddClicked" BackgroundColor="#1C6B4C" TextColor="White"/>
  <Button Text="Revisar alertas" Clicked="AlertsClicked"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>
